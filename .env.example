# Copy to .env and fill in: cp .env.example .env

# --- LLM (app/agent.py) ---
# Format provider:model. Default: openai:gpt-4.1
LLM_MODEL=openai:gpt-4.1
OPENAI_API_KEY=sk-...                # required when LLM_MODEL=openai:...
# ANTHROPIC_API_KEY=sk-ant-...        # if LLM_MODEL=anthropic:...
# OLLAMA_BASE_URL=http://host.docker.internal:11434   # if LLM_MODEL=ollama:...

# --- Cube (app/cube_client.py) ---
# Must match CUBEJS_API_SECRET of the cube service. Use >= 32 chars outside dev.
CUBEJS_API_SECRET=dev-secret-change-me
CUBE_API_URL=http://localhost:4000/cubejs-api/v1   # docker-compose overrides to http://cube:4000/...
CUBE_TIMEZONE=Asia/Singapore
CUBE_SQL_USER=cube
CUBE_SQL_PASSWORD=cube

# --- Agent memory (optional) ---
# Unset = in-memory (lost on restart). Set for persistent memory on Postgres:
# AGENT_DB_URI=postgresql://agent:agent@localhost:5432/agent

# --- Object storage (RustFS, S3-compatible) ---
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1

# --- Airflow (docker-compose-airflow.yaml) ---
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change-me
# Required by docker-compose-airflow.yaml. Generate: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=

# --- Tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=lakehouse-llm-analytics

# --- DataHub (docker-compose-datahub.yaml) ---
DATAHUB_VERSION=v1.8.0
# Spark listener target, inside data-platform-net. Set empty to turn Spark lineage off.
DATAHUB_GMS_URL=http://datahub-gms:8080
# Host ports: GMS (8080 is the Spark master UI) and the web UI
DATAHUB_GMS_PORT=8091
DATAHUB_FRONTEND_PORT=9002
# Required. Generate each with: openssl rand -hex 32
DATAHUB_TOKEN_SERVICE_SALT=
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=
